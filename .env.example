# كلمة مرور لوحة التحكم (/admin/login)
ADMIN_PASSWORD=change-me

# مفتاح سري طويل وعشوائي — يوقّع جلسات الأدمن، جلسات العملاء، ورموز التحقق (OTP)
ADMIN_SECRET=change-me-to-a-long-random-string

# GREEN-API (واتساب) — مطلوب لتفعيل دخول العملاء برمز واتساب
# من لوحة green-api.com: انسخ معرّف الحساب (idInstance) والتوكن (ApiTokenInstance)
# عنوان API يختلف حسب حسابك، مثال: https://7107.api.greenapi.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=https://7107.api.greenapi.com

# رابط Webhook ديسكورد — يصل إشعار بكل طلب جديد إلى الروم المرتبط به
# من إعدادات الروم: التكاملات → Webhooks → نسخ رابط الـ Webhook
DISCORD_WEBHOOK_URL=

# بديل اختياري: WhatsApp Cloud API من Meta (يُستخدم فقط إن لم تُضبط GREEN-API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_TEMPLATE_LANG=ar
